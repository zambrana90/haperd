# Copy this file to .env.local and fill in the values there. Never commit values.

# Brevo API key (server only; used from Phase 3).
BREVO_API_KEY=
# Sender address verified in Brevo (used from Phase 3).
BREVO_SENDER_EMAIL=
# Sender display name (used from Phase 3).
BREVO_SENDER_NAME=
# Address where enquiries arrive. The contact form fails without it.
CONTACT_TO_EMAIL=
# Canonical site URL for metadata and the sitemap. Public: it reaches the browser.
NEXT_PUBLIC_SITE_URL=

# SMTP settings the current contact route uses. Phase 3 removes them.

# SMTP server host name.
SMTP_HOST=
# SMTP port. The route uses 465 when empty and always connects with TLS.
SMTP_PORT=
# SMTP user name, also used as the sender address.
SMTP_USER=
# SMTP password.
SMTP_PASS=
