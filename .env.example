# Copy this file to .env.local and fill in the values there. Never commit values.
# The contact form needs the two BREVO_SENDER_* values, BREVO_API_KEY and CONTACT_TO_EMAIL.

# Brevo API key (server only).
BREVO_API_KEY=
# Sender address verified in Brevo.
BREVO_SENDER_EMAIL=
# Sender display name.
BREVO_SENDER_NAME=
# Address where enquiries arrive.
CONTACT_TO_EMAIL=
# Canonical site URL for metadata and the sitemap. Public: it reaches the browser.
NEXT_PUBLIC_SITE_URL=
